<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AndyTV.Maui.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vlc="clr-namespace:LibVLCSharp.MAUI;assembly=LibVLCSharp.MAUI"
    xmlns:vm="clr-namespace:AndyTV.Maui.ViewModels"
    Title="{Binding ChannelName}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    x:DataType="vm:PlayerViewModel">

    <Grid BackgroundColor="Black">
        <vlc:VideoView
            x:Name="VideoView"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <BoxView
            BackgroundColor="Transparent"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer x:Name="PlayerTapGesture" NumberOfTapsRequired="1" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Button
            x:Name="BackButton"
            Margin="16,24,16,16"
            Padding="14,8"
            BackgroundColor="#80000000"
            Command="{Binding GoBackCommand}"
            CornerRadius="18"
            HorizontalOptions="Start"
            IsVisible="{Binding CanGoBack}"
            Text="Back to list"
            TextColor="White"
            VerticalOptions="Start" />
    </Grid>
</ContentPage>