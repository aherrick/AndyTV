<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0-ios</TargetFramework>
		<!-- Restore both simulator RIDs so the IDE's choice always has an assets target; device builds pass -r ios-arm64. -->
		<RuntimeIdentifiers>iossimulator-arm64;iossimulator-x64</RuntimeIdentifiers>
		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>

		<OutputType>Exe</OutputType>
		<RootNamespace>AndyTV.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
		<!-- [RelayCommand] methods must stay instance members even when they touch no instance state. -->
		<NoWarn>$(NoWarn);CA1822</NoWarn>
		<Nullable>disable</Nullable>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>AndyTV</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.ajh.AndyTV</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\AppIcon\appicon.png" Color="#000000" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="11.0.0-rc.2.26505.5" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0-rc.2.26505.5" />
		<PackageReference Include="LibVLCSharp.MAUI" Version="3.10.2" />
		<PackageReference Include="VideoLAN.LibVLC.iOS" Version="3.6.1" />
		<PackageReference Include="Syncfusion.Maui.ListView" Version="35.1.42" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AndyTV.Data\AndyTV.Data.csproj" />
	</ItemGroup>

</Project>
