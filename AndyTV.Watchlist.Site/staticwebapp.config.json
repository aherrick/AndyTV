{
  "routes": [
    {
      "route": "/",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/privacy",
      "rewrite": "/privacy.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/styles.css", "/*.json", "/*.txt", "/*.html", "/*.webmanifest", "/*.ico", "/*.png"]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}

