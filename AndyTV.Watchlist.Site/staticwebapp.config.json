{
    "routes": [
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/styles.css", "/app.js", "/*.json", "/*.webmanifest", "/*.ico", "/*.png"]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}

