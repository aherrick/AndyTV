{
  "routes": [
    {
      "route": "/",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/privacy",
      "rewrite": "/privacy.html"
    },
    {
      "route": "/about",
      "rewrite": "/about.html"
    },
    {
      "route": "/contact",
      "rewrite": "/contact.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/styles.css", "/*.json", "/*.txt", "/*.html", "/*.webmanifest", "/*.ico", "/*.png", "/20*", "/archive*"]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json",
    ".xml": "application/xml"
  }
}

